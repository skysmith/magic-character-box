#!/usr/bin/env python3
"""Narrow NetworkManager helper for the local web-admin Wi-Fi setup flow."""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile


RECOVERY_ENV = Path(os.getenv("STORY_DOCK_SETUP_HOTSPOT_ENV", "/etc/story-dock/setup-hotspot.env"))
MAX_SECRET_PAYLOAD_BYTES = 4096
MANAGED_WIFI_CONNECTION = "story-dock-provisioned-wifi"


def main() -> int:
    parser = argparse.ArgumentParser(description="Run approved NetworkManager Wi-Fi actions.")
    subparsers = parser.add_subparsers(dest="command", required=True)
    subparsers.add_parser("radio-status")
    subparsers.add_parser("radio-on")
    subparsers.add_parser("device-status")
    subparsers.add_parser("rescan")
    subparsers.add_parser("list")
    subparsers.add_parser("connect-stdin")
    subparsers.add_parser("set-recovery-password-stdin")

    args = parser.parse_args()
    nmcli = shutil.which("nmcli") or "/usr/bin/nmcli"
    if not os.path.exists(nmcli):
        print("NetworkManager nmcli is not installed.", file=sys.stderr)
        return 127

    if args.command == "radio-status":
        return run(nmcli, "radio", "wifi")
    if args.command == "radio-on":
        return run(nmcli, "radio", "wifi", "on")
    if args.command == "device-status":
        return run(nmcli, "-t", "--escape", "yes", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", "status")
    if args.command == "rescan":
        return run(nmcli, "device", "wifi", "rescan")
    if args.command == "list":
        return run(nmcli, "-t", "--escape", "yes", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list")
    if args.command == "connect-stdin":
        payload = read_secret_payload()
        ssid = validate_payload_value(payload, "ssid", "Wi-Fi network name")
        password = validate_payload_value(payload, "password", "Wi-Fi password")
        command = [
            nmcli,
            "device",
            "wifi",
            "connect",
            ssid,
            "name",
            MANAGED_WIFI_CONNECTION,
        ]
        if password:
            command.insert(1, "--ask")
        return run_command(command, input_text=f"{password}\n" if password else None)
    if args.command == "set-recovery-password-stdin":
        payload = read_secret_payload()
        password = validate_recovery_password(
            validate_payload_value(payload, "password", "Recovery Wi-Fi password")
        )
        return set_recovery_password(password)

    return 2


def validate_value(value: str, label: str) -> str:
    if any(char in value for char in "\x00\n\r"):
        raise SystemExit(f"{label} contains unsupported characters.")
    return value


def read_secret_payload() -> dict[str, object]:
    raw = sys.stdin.read(MAX_SECRET_PAYLOAD_BYTES + 1)
    if len(raw.encode("utf-8")) > MAX_SECRET_PAYLOAD_BYTES:
        raise SystemExit("Wi-Fi request is too large.")
    try:
        payload = json.loads(raw)
    except (json.JSONDecodeError, UnicodeError) as exc:
        raise SystemExit("Wi-Fi request is invalid.") from exc
    if not isinstance(payload, dict):
        raise SystemExit("Wi-Fi request is invalid.")
    return payload


def validate_payload_value(payload: dict[str, object], key: str, label: str) -> str:
    value = payload.get(key, "")
    if not isinstance(value, str):
        raise SystemExit(f"{label} is invalid.")
    return validate_value(value, label)


def validate_recovery_password(value: str) -> str:
    password = validate_value(value, "Recovery Wi-Fi password")
    if not 8 <= len(password) <= 63:
        raise SystemExit("Recovery Wi-Fi password must be 8–63 characters.")
    return password


def set_recovery_password(password: str) -> int:
    if not RECOVERY_ENV.is_file():
        print("Story Dock recovery Wi-Fi is not configured.", file=sys.stderr)
        return 2

    lines = RECOVERY_ENV.read_text(encoding="utf-8").splitlines()
    replacement = f"STORY_DOCK_SETUP_HOTSPOT_PSK={shell_single_quote(password)}"
    updated: list[str] = []
    replaced = False
    for line in lines:
        if line.startswith("STORY_DOCK_SETUP_HOTSPOT_PSK="):
            if replaced:
                print("Story Dock recovery configuration contains duplicate password entries.", file=sys.stderr)
                return 2
            updated.append(replacement)
            replaced = True
        else:
            updated.append(line)
    if not replaced:
        updated.append(replacement)

    RECOVERY_ENV.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=".setup-hotspot.", dir=RECOVERY_ENV.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write("\n".join(updated) + "\n")
        os.chmod(temporary_name, 0o600)
        os.replace(temporary_name, RECOVERY_ENV)
    finally:
        if os.path.exists(temporary_name):
            os.unlink(temporary_name)

    # The recovery hotspot rebuilds its NetworkManager profile from this file
    # whenever the next setup session starts. Do not put this future-session
    # credential in a child process argument merely to alter the active session.
    return 0


def shell_single_quote(value: str) -> str:
    return "'" + value.replace("'", "'\"'\"'") + "'"


def run(nmcli: str, *args: str) -> int:
    return run_command([nmcli, *args])


def run_command(command: list[str], *, input_text: str | None = None) -> int:
    completed = subprocess.run(command, check=False, input=input_text, text=True)
    return completed.returncode


if __name__ == "__main__":
    raise SystemExit(main())
